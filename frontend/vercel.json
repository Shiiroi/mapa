{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/region/:slug",
            "destination": "/:slug",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/geo-cdn/:path*",
            "destination": "https://pub-f9d925e99cc844ad9fac924a16e8f3a3.r2.dev/:path*"
        },
        {
            "source": "/province/:slug",
            "destination": "/api/legacy-redirect?type=province&slug=:slug"
        },
        {
            "source": "/municipality/:slug",
            "destination": "/api/legacy-redirect?type=municipality&slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
